# Copy this file to .env and fill in your real values.
#   cp .env.example .env

# Your Postgres connection string (Prisma / @prisma/adapter-pg)
# Free hosted Postgres: npx create-db
# Or use a local Postgres / Supabase / Neon / Railway instance.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public

# Your Resend API key. Get one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Verified "from" address. Must use a domain you verified in Resend
# (format: "Your Name <you@yourdomain.com>").
RESEND_FROM_EMAIL="hoceinir <contact@yourdomain.com>"

# Where contact messages are delivered (your inbox).
CONTACT_TO_EMAIL=you@yourdomain.com
